{
  "name": "pariksha-verse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.0",
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/generate-build-info.mjs",
    "build": "node scripts/generate-build-info.mjs && next build",
    "start": "next start",
    "vinext:dev": "vinext dev",
    "vinext:build": "node scripts/generate-build-info.mjs && vinext build",
    "vinext:deploy": "vinext-cloudflare deploy",
    "cf:build": "node scripts/generate-build-info.mjs && vinext build",
    "cf:preview": "vinext-cloudflare deploy --preview",
    "cf:deploy:staging": "vinext-cloudflare deploy --env staging",
    "cf:deploy:prod": "vinext-cloudflare deploy --env production",
    "lint": "next lint",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "wrangler d1 migrations apply pariksha-verse-db-local --local",
    "db:migrate:staging": "wrangler d1 migrations apply pariksha-verse-db-staging --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply pariksha-verse-db-production --env production --remote",
    "db:seed": "tsx src/db/seeds/run.ts",
    "db:seed:staging": "tsx src/db/seeds/run.ts --env=staging",
    "db:seed:prod": "tsx src/db/seeds/run.ts --env=production",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.475.0",
    "next": "15.5.26",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vinext/cloudflare": "1.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "15.2.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vinext": "1.0.0",
    "vite": "^8.3.0",
    "vitest": "^3.0.5",
    "wrangler": "4.141.0"
  },
  "type": "module"
}
