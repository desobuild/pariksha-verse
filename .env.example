# Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit sensitive secrets, credentials, or API keys.

NODE_ENV=development

# Brand & App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Security
# Generate a cryptographically random secret of at least 32 bytes.
# Example:
#   openssl rand -base64 32
#
# Use a unique value for every environment.
# NEVER use the placeholder value in a running environment.
SESSION_SECRET=replace_with_a_secure_random_32_byte_secret_for_local_dev

# Transactional Email Provider
# Resend HTTP API key used by the production magic-link authentication flow.
#
# Staging uses demo authentication and does not require this value.
# Local development can run without an API key; email dispatch safely
# falls back to console logging.
RESEND_API_KEY=

# Sender address used for authentication emails.
EMAIL_FROM=ParikshaVerse <auth@parikshaverse.in>

# Automated Testing Authentication
# Keep this false for normal development.
# This must remain false in staging and production.
ENABLE_TEST_AUTH_MOCK=false