# Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit sensitive secrets or credentials.

NODE_ENV=development

# Cloudflare D1 Database (configured via wrangler.jsonc bindings for Workers/D1)
# Local database uses wrangler local persistence or in-memory sqlite
DB_NAME=pariksha-verse-db

# Brand & App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Security
# Generate a 32+ byte cryptographically random string for HMAC signing (e.g., openssl rand -base64 32)
# NEVER use default values in staging or production.
SESSION_SECRET=replace_with_a_secure_random_32_byte_secret_for_local_dev

# Transactional Email Provider (Resend HTTP API)
# Used by the production magic-link authentication flow only.
# NOT required for staging demo authentication (Phase 13A.3): when the server-side
# ENVIRONMENT is "staging", /api/auth/demo provides a no-email demo sign-in.
# In local development without an API key, email dispatch safely logs to console.
RESEND_API_KEY=
EMAIL_FROM=ParikshaVerse <auth@parikshaverse.in>

# Automated Testing Flag (defaults to false; strictly forbidden in staging/production)
ENABLE_TEST_AUTH_MOCK=false
