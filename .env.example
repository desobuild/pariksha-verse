# Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit sensitive secrets or credentials.

NODE_ENV=development

# Cloudflare D1 Database (configured via wrangler.jsonc bindings for Workers/D1)
# Local database uses wrangler local persistence or in-memory sqlite
DB_NAME=pariksha-verse-db

# Brand & App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Security
# Generate a 32+ byte cryptographically random string for production HMAC signing
SESSION_SECRET=pariksha_verse_dev_secret_key_change_in_production_32b

